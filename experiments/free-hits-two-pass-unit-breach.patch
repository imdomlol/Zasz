+    def assign_targets(self) -> None:
+        """Targets for every zergling in a fight this step, in two passes over all squads: first the
+        ones not hitting anything (just arrived, walking in, target dead) fill the best targets with
+        room; then the ones already hitting something switch only into room still left. So nobody is
+        pulled off a free building while a zergling with nothing to do could take that slot."""
+
+        def working(unit: Unit, ctx: FightContext) -> bool:
+            target = ctx.by_tag.get(unit.order_target) if isinstance(unit.order_target, int) else None
+            return target is not None and unit.target_in_range(target, 0.5)
+
+        idle = [(u, c) for u, c in self.pending if not working(u, c)]
+        busy = [(u, c) for u, c in self.pending if working(u, c)]
+        for group in (idle, busy) if TWO_PASS else (idle + busy,):
+            group.sort(key=lambda uc: min((uc[0].position.distance_to(e.position) for e in uc[1].enemies), default=0))
+            for unit, ctx in group:
+                fight(ctx.ai, unit, ctx.threats, ctx.enemies, ctx.slots, ctx.position, self.blocks, self.detours)
+        self.pending = []
 
